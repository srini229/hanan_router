MACRO BLOCK_A
  UNITS 
    DATABASE MICRONS UNITS 1;
  END UNITS 
  ORIGIN 0 0 ;
  FOREIGN BLOCK_A 0 0 ;
  SIZE 100 BY 100 ;
  PIN A
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
        RECT 0 0 32 100 ;
    END
  END A
  PIN B
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
        RECT 64 0 96 100 ;
    END
  END B
END BLOCK_A
