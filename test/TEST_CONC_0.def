VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN TEST_CONC_0 ;
UNITS DISTANCE MICRONS 1 ;
DIEAREA ( 0 0 ) ( 1000 1000 ) ; 

COMPONENTS 2 ;
- J_0 BLOCK_B_CONC_0 + PLACED ( 0 0 ) N ;
- J_1 BLOCK_B_CONC_0 + PLACED ( 2000 0 ) N ;
END COMPONENTS

NETS 2 ;
 - C
 ( J_0/X J_0/X ) ( J_1/X J_1/X )
  + RECT M2 ( 1016 60 ) ( 1984 92 )
 ;
- D
 ( J_1/Y J_1/Y ) ( J_0/Y J_0/Y )
  + RECT M2 ( 952 780 ) ( 2044 812 )
 ;
END NETS

END DESIGN
